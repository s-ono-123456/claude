# Mattermost 接続設定
# このファイルを ~/.claude/mattermost.env としてコピーして実際の値を記入してください
# cp .env.example ~/.claude/mattermost.env

MATTERMOST_URL=https://your-mattermost.example.com
MATTERMOST_BOT_TOKEN=your-personal-access-token-here
MATTERMOST_CHANNEL_ID=your-channel-id-here

# ─── トグル ───────────────────────────────────────────────
# 1=有効 / 0=無効
# ./hooks/mattermost_toggle.sh on|off でも変更可能
MATTERMOST_ENABLED=1

# ─── Stop フック設定 ───────────────────────────────────────
# 返信を待機する最大秒数（デフォルト: 5分）
MATTERMOST_REPLY_TIMEOUT=300

# ポーリング間隔秒数
MATTERMOST_POLL_INTERVAL=15

# ─── PreToolUse フック設定（ツール承認） ────────────────────
# 承認の返信を待機する最大秒数（デフォルト: 2分）
MATTERMOST_APPROVAL_TIMEOUT=120

# タイムアウト時のデフォルト動作: 1=自動承認 / 0=自動ブロック
MATTERMOST_DEFAULT_APPROVE=1

# ─── 共通設定 ─────────────────────────────────────────────
# Mattermost に表示するサマリーの最大文字数
MATTERMOST_SUMMARY_CHARS=800
